{
  "name": "ielts-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:words": "node scripts/prepare-words.mjs",
    "prepare:listening": "node scripts/prepare-listening.mjs",
    "predev": "npm run prepare:words && npm run prepare:listening",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "prebuild": "npm run prepare:words && npm run prepare:listening",
    "build": "vite build && node scripts/copy-audio.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@primeuix/themes": "2.0.3",
    "primevue": "4.5.5",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "vite": "8.3.3"
  }
}
